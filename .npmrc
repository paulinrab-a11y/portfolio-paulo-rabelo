# Proteção contra pacotes maliciosos (ver SECURITY.md)
# Só instala versões publicadas há pelo menos 7 dias: a maioria dos pacotes
# comprometidos é removida do registro antes disso.
min-release-age=7
# Dependências não executam scripts de instalação na sua máquina nem no build.
ignore-scripts=true
# Versões exatas no package.json ao instalar algo novo.
save-exact=true
audit-level=high

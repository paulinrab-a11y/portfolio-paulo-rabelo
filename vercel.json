{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "routes": [
    {
      "src": "^/\\.(?!well-known/).*",
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/(wp-admin|wp-content|wp-includes|wp-json|phpmyadmin|pma|cgi-bin|vendor|administrator)(/.*)?$",
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/.*\\.(php|asp|aspx|jsp|cgi|sql|bak|old|swp|ini|env)$",
      "mitigate": { "action": "deny" }
    }
  ]
}
